{%- comment -%}
  Ricreo · stile e script globali.
  - Token (Impostazioni tema → Ricreo · Stile): le sezioni e i blocchi rc-* leggono --rc-accent
    da qui, salvo override locale.
  - Micro-animazione dell'icona carrello, badge di compatibilità <rc-compat> e rc-garage.js
    (il badge vive anche dentro le card prodotto di Horizon).
  Renderizzato in layout/theme.liquid subito dopo 'color-palette'.
{%- endcomment -%}

<script src="{{ 'rc-garage.js' | asset_url }}" type="module" fetchpriority="low"></script>

{%- liquid
  assign rc_accent = settings.rc_accent
  if rc_accent == blank
    assign rc_accent = '#FF5A1F'
  endif
-%}

<style>
  :root {
    --rc-accent: {{ rc_accent }};
    --rc-accent-2: {{ rc_accent | color_modify: 'hue', 30 | color_lighten: 8 }};
    --rc-accent-ink: {{ rc_accent | color_darken: 18 }};
    --rc-accent-tint: {{ rc_accent | color_mix: '#ffffff', 10 }};
  }

  ::selection {
    background-color: color-mix(in srgb, var(--rc-accent) 24%, transparent);
  }

  /* The header cart icon gives a little hop while Horizon animates the count bubble. */
  @keyframes rc-cart-bump {
    30% {
      transform: translateY(-3px) rotate(-8deg);
    }
    60% {
      transform: translateY(0) rotate(5deg);
    }
  }

  .header-actions__cart-icon:has(.cart-bubble--animating) svg {
    animation: rc-cart-bump 0.5s cubic-bezier(0.3, 0.7, 0.4, 1.4);
  }

  /* Long marketplace-style product titles: two lines on cards keep the grid even. */
  product-card [ref='productTitleLink'] p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* Product photos are mostly wide shots on white: show them whole inside the square card instead of
     cropping (Horizon's card gallery sets object-fit: cover inline, hence !important). The card gets a
     soft warm tint and multiply drops the photo's white box, so every piece sits on the same "studio" floor. */
  product-card .card-gallery {
    overflow: hidden;
    border-radius: 16px;
  }

  product-card .card-gallery .product-media-container {
    background-color: color-mix(in srgb, var(--color-foreground) 4%, var(--color-background));
  }

  product-card .card-gallery .product-media-container img {
    object-fit: contain !important;
    padding: 6%;
    mix-blend-mode: multiply;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  product-card:hover .card-gallery .product-media-container img {
    transform: scale(1.04);
  }

  product-card [ref='productTitleLink'] p {
    font-weight: 500;
    line-height: 1.35;
  }

  /* Prices: readable and bold; a discounted price takes the accent, the old one steps back. */
  product-card product-price {
    --font-h6--size: 1rem;
    --font-h6--weight: 700;
  }

  product-card product-price:has(.compare-at-price) .price {
    color: var(--rc-accent-ink, var(--rc-accent));
  }

  product-card product-price .compare-at-price {
    font-size: 0.85em;
    font-weight: 400;
  }

  /* Product page: the price is the second thing people look for after the name, so it reads big. */
  product-price:not(product-card product-price) .price {
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  product-price:not(product-card product-price):has(.compare-at-price) .price {
    color: var(--rc-accent-ink, var(--rc-accent));
  }

  product-price:not(product-card product-price) .compare-at-price {
    margin-inline-start: 6px;
    font-size: 1.05rem;
    opacity: 0.6;
  }

  product-card .product-badges__badge.color-custom-badge-sale {
    padding-inline: 10px;
    border-radius: 999px;
    background: var(--rc-accent-ink, var(--rc-accent));
    color: #fff;
    font-weight: 700;
  }

  /* Vehicle compatibility badge (rc-garage.js fills it in). */
  rc-compat {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.85rem;
    line-height: 1.35;
  }

  rc-compat[hidden] {
    display: none;
  }

  .rc-compat__icon {
    flex: none;
    margin-block-start: 1px;
  }

  rc-compat[data-tone='ok'] {
    color: #15803d;
  }

  rc-compat[data-context='product'] {
    padding: 10px 14px;
    border-radius: 14px;
    background: #ecfdf3;
  }

  rc-compat[data-context='card'] {
    font-size: 0.78rem;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .header-actions__cart-icon:has(.cart-bubble--animating) svg {
      animation: none;
    }

    product-card .card-gallery .product-media-container img {
      transition: none;
    }

    product-card:hover .card-gallery .product-media-container img {
      transform: none;
    }
  }
</style>
