{%- doc -%}
  Ricreo · card prodotto compatta: miniatura, nome corto, "per …" e prezzo.
  Il titolo viene diviso al primo " per ": il nome resta su una riga leggibile e i modelli
  compatibili vanno sotto, in grigio, invece di un titolo lungo troncato a metà.

  @param {product} product - Il prodotto
  @param {string} [class] - Classe aggiuntiva sul link
  @param {string} [loading] - 'eager' o 'lazy' (predefinito)
{%- enddoc -%}

{%- liquid
  assign loading = loading | default: 'lazy'
  assign name = product.title | split: ' per ' | first
  assign fit = ''
  if product.title contains ' per '
    assign fit = product.title | remove_first: name | remove_first: ' per ' | strip
  endif
-%}

<a class="rc-chip-card {{ class }}" href="{{ product.url }}">
  <span class="rc-chip-card__media">
    {{
      product.featured_image
      | image_url: width: 240
      | image_tag: loading: loading, sizes: '96px', alt: '', class: 'rc-chip-card__img'
    }}
  </span>
  <span class="rc-chip-card__body">
    <span class="rc-chip-card__name">{{ name }}</span>
    {%- if fit != blank -%}
      <span class="rc-chip-card__fit">per {{ fit }}</span>
    {%- endif -%}
    <span class="rc-chip-card__price">
      {{ product.price | money }}
      {%- if product.compare_at_price > product.price -%}
        <s>{{ product.compare_at_price | money }}</s>
      {%- endif -%}
    </span>
  </span>
</a>

{% stylesheet %}
  .rc-chip-card {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    padding: 10px 14px 10px 10px;
    border-radius: 18px;
    background: var(--color-background);
    color: var(--color-foreground);
    text-decoration: none;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 18px 40px -18px rgb(0 0 0 / 0.28);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.3s;
  }

  .rc-chip-card:hover {
    transform: translateY(-3px);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 24px 44px -18px rgb(0 0 0 / 0.34);
  }

  .rc-chip-card__media {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 12px;
    background: color-mix(in srgb, var(--rc-accent) 7%, var(--color-background));
  }

  /* Product shots are on white: multiply drops the white box so the piece sits on the tint. */
  .rc-chip-card__img {
    width: 100%;
    height: 100%;
    padding: 6px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .rc-chip-card__body {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .rc-chip-card__name {
    overflow: hidden;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rc-chip-card__fit {
    overflow: hidden;
    font-size: 0.76rem;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .rc-chip-card__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-block-start: 3px;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .rc-chip-card__price s {
    font-size: 0.76rem;
    font-weight: 500;
    color: rgb(var(--color-foreground-rgb) / 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .rc-chip-card {
      transition: none;
    }

    .rc-chip-card:hover {
      transform: none;
    }
  }
{% endstylesheet %}
