{%- doc -%}
  Ricreo icon library. Stroke icons on a 24x24 grid that inherit `currentColor`.
  Kept separate from Horizon's `icon.liquid` so upstream merges never conflict.

  @param {string} name - Icon name (car, wrench, shield, truck, bulb, layers, disc, drop, sparkle, bolt,
    sun, ruler, leaf, check, star, seat, wheel, gear, engine, spray, return, headset, lock, tag, plus,
    arrow-right, search, close, garage, mirror, exhaust, palette, cart, gift, home, monitor, bug, van, scooter)
  @param {string} [class] - Extra CSS classes
  @param {number} [size] - Pixel size (default 24)

  @example
  {% render 'rc-icon', name: 'wrench', size: 20 %}
{%- enddoc -%}

{%- liquid
  assign size = size | default: 24
-%}
<svg
  class="rc-icon rc-icon--{{ name }} {{ class }}"
  width="{{ size }}"
  height="{{ size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'car' -%}
      <path d="M5 16.5h14M3.5 16.5v-3.2c0-.6.2-1.1.6-1.5L6 9.6l1.4-3.1A2 2 0 0 1 9.2 5.3h5.6a2 2 0 0 1 1.8 1.2L18 9.6l1.9 2.2c.4.4.6.9.6 1.5v3.2"/><path d="M6 9.6h12"/><circle cx="7.5" cy="16.5" r="1.8"/><circle cx="16.5" cy="16.5" r="1.8"/>
    {%- when 'wrench' -%}
      <path d="M14.7 6.3a4 4 0 0 0 5 5L21 12.6a6 6 0 0 1-7.4 1.3L6.6 20.9a2 2 0 0 1-2.8-2.8l7-7A6 6 0 0 1 12.1 3.7z"/>
    {%- when 'shield' -%}
      <path d="M12 3 4.5 6v5.5c0 4.4 3.1 8.3 7.5 9.5 4.4-1.2 7.5-5.1 7.5-9.5V6z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/>
    {%- when 'bulb' -%}
      <path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1 2V16h5.2v-.2c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z"/>
    {%- when 'layers' -%}
      <path d="m12 3 9 4.8-9 4.8-9-4.8z"/><path d="m3 12.2 9 4.8 9-4.8"/><path d="m3 16.4 9 4.8 9-4.8"/>
    {%- when 'disc' -%}
      <circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="2.5"/><path d="M12 3.5v3M12 17.5v3M3.5 12h3M17.5 12h3"/><path d="M17 5.5a9 9 0 0 1 1.5 3.5" stroke-width="3"/>
    {%- when 'drop' -%}
      <path d="M12 3.5s-6 6.6-6 11a6 6 0 0 0 12 0c0-4.4-6-11-6-11z"/><path d="M9.5 15a2.5 2.5 0 0 0 2.5 2.5"/>
    {%- when 'sparkle' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="m12 8 1.2 2.8L16 12l-2.8 1.2L12 16l-1.2-2.8L8 12l2.8-1.2z"/><path d="M18.5 4.5v2M17.5 5.5h2"/>
    {%- when 'bolt' -%}
      <path d="M13 2.5 4.5 13.5H12l-1 8 8.5-11H12z"/>
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>
    {%- when 'ruler' -%}
      <path d="m3.5 16.5 13-13 4 4-13 13z"/><path d="m7 13 1.8 1.8M10 10l1.8 1.8M13 7l1.8 1.8"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19 12 12"/>
    {%- when 'star' -%}
      <path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
    {%- when 'seat' -%}
      <path d="M8 3.5h3.5l1 9H17a2 2 0 0 1 2 2v2.5H7.5L6 5.5a1.8 1.8 0 0 1 2-2z"/><path d="M9 17v3.5M16.5 17v3.5"/>
    {%- when 'wheel' -%}
      <circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/><path d="M12 7.5v3.5M16.3 13.4 13 12.3M7.7 13.4 11 12.3"/>
    {%- when 'gear' -%}
      <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>
    {%- when 'engine' -%}
      <path d="M4 10h2V8h3V6h5v2h2l2 2h2v6h-2l-2 2H9l-3-3H4z"/><path d="M2 11v4M11 11l-1.5 3h3L11 17"/>
    {%- when 'spray' -%}
      <path d="M8 9h6v11.5H8z"/><path d="M9.5 9V6.5h3V9M12.5 6.5h2l1.5-1.5"/><path d="M18 4h.01M20 6h.01M18 8h.01M20 3h.01"/>
    {%- when 'return' -%}
      <path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>
    {%- when 'headset' -%}
      <path d="M4 14v-2a8 8 0 0 1 16 0v2"/><path d="M4 14h3v5H5.5A1.5 1.5 0 0 1 4 17.5zM20 14h-3v5h1.5a1.5 1.5 0 0 0 1.5-1.5z"/><path d="M17 19c0 1.5-1.5 2-3.5 2"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
    {%- when 'tag' -%}
      <path d="M3.5 12.6V4.5a1 1 0 0 1 1-1h8.1l8 8a1.4 1.4 0 0 1 0 2l-7.1 7.1a1.4 1.4 0 0 1-2 0z"/><circle cx="8" cy="8" r="1.3"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'garage' -%}
      <path d="M3 9.5 12 4l9 5.5V20H3z"/><path d="M6.5 20v-7h11v7M6.5 15.5h11M6.5 18h11"/>
    {%- when 'mirror' -%}
      <path d="M4 9.5C4 7 6 5.5 9 5.5h6c3 0 5 1.5 5 4s-2 5-8 5-8-2.5-8-5z"/><path d="M12 14.5V19M9 19h6"/>
    {%- when 'exhaust' -%}
      <path d="M3 12h11a3 3 0 0 1 3 3v0a3 3 0 0 1-3 3H3z"/><path d="M17 15h1.5M20 12.5c1 .8 1 2.2 0 3M20 9.5c2.2 1.7 2.2 5.3 0 7"/>
    {%- when 'palette' -%}
      <path d="M12 3.5a8.5 8.5 0 0 0 0 17c1.2 0 1.8-.8 1.8-1.7 0-1.3-1-1.5-1-2.6 0-.9.8-1.6 1.7-1.6h2.2a3.8 3.8 0 0 0 3.8-3.8c0-4-3.8-7.3-8.5-7.3z"/><circle cx="7.8" cy="11" r="1"/><circle cx="10.5" cy="7.5" r="1"/><circle cx="15" cy="8" r="1"/>
    {%- when 'cart' -%}
      <path d="M3 4h2.2l2.2 11h10.4l2-8H6.3"/><circle cx="9" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="8" width="17" height="4" rx="1"/><path d="M5 12v8.5h14V12M12 8v12.5"/><path d="M12 8C10.5 4.5 7 4.5 7 6.5S10 8 12 8zM12 8c1.5-3.5 5-3.5 5-1.5S14 8 12 8z"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8.5"/><path d="m8.2 12.2 2.6 2.6 5-5.2"/>
    {%- when 'home' -%}
      <path d="M3.5 11 12 4l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/>
    {%- when 'monitor' -%}
      <rect x="3" y="4.5" width="18" height="12" rx="2"/><path d="M8.5 20h7M12 16.5V20"/>
    {%- when 'bug' -%}
      <path d="M8 9.5a4 4 0 0 1 8 0v4.5a4 4 0 0 1-8 0z"/><path d="M12 9.5V18M9.5 6.5 8 4.5M14.5 6.5 16 4.5M8 12H4.5M19.5 12H16M8 16l-3 1.5M16 16l3 1.5"/>
    {%- when 'van' -%}
      <path d="M3 16.5V7.5a2 2 0 0 1 2-2h10.5l3.2 4.2 1.8.8v6"/><path d="M3 16.5h2.5M10.5 16.5h4M19.5 16.5h1"/><circle cx="8" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M7 9h4v3H7z"/>
    {%- when 'scooter' -%}
      <circle cx="5.5" cy="16.5" r="2.5"/><circle cx="18.5" cy="16.5" r="2.5"/><path d="M8 16.5h6l3-7h-2.5M14.5 9.5h3"/><path d="M8 16.5 10 11H5.5"/>
  {%- endcase -%}
</svg>
