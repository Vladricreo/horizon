{%- comment -%}
  Ricreo · Barra garage (gruppo header).
  Mostra l'auto salvata dal cliente su tutto il sito, con "Cambia" / rimuovi e,
  nelle collezioni, il filtro rapido "Solo ricambi per la tua auto" (collezione filtrata per tag).
{%- endcomment -%}

<script src="{{ 'rc-garage.js' | asset_url }}" type="module" fetchpriority="low"></script>

{%- liquid
  assign finder_url = section.settings.finder_url | default: routes.root_url
  assign finder_url = finder_url | append: '#rc-finder'
-%}

<rc-garage-bar
  class="rc-gbar"
  data-show-empty="{{ section.settings.show_empty }}"
  data-cart-update-url="{{ routes.cart_update_url }}.js"
  {% if collection and template.name == 'collection' %}
    data-collection-url="{{ collection.url }}"
    data-current-tags="{{ current_tags | join: '|' | escape }}"
  {% endif %}
  {% unless section.settings.show_empty %}
    hidden
  {% endunless %}
>
  <div class="rc-gbar__inner">
    <span class="rc-gbar__badge" aria-hidden="true">{% render 'rc-icon', name: 'car', size: 16 %}</span>

    <p class="rc-gbar__text" data-rc-gbar-empty>{{ section.settings.empty_text }}</p>
    <p class="rc-gbar__text" data-rc-gbar-saved hidden>
      La tua auto: <strong data-rc-gbar-label></strong>
    </p>

    <div class="rc-gbar__actions">
      <a class="rc-gbar__filter" data-rc-gbar-filter hidden></a>
      <a class="rc-gbar__link" href="{{ finder_url }}" data-rc-gbar-change>Scegli auto</a>
      <button type="button" class="rc-gbar__clear" data-rc-gbar-clear aria-label="Rimuovi la tua auto" hidden>
        {% render 'rc-icon', name: 'close', size: 14 %}
      </button>
    </div>
  </div>
</rc-garage-bar>

{% stylesheet %}
  .rc-gbar {
    display: block;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    background: color-mix(in srgb, var(--rc-accent) 6%, var(--color-background));
    font-size: 0.85rem;
  }

  .rc-gbar[hidden] {
    display: none;
  }

  .rc-gbar__inner {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: var(--page-width);
    margin-inline: auto;
    padding: 7px var(--page-margin);
    min-height: 40px;
  }

  .rc-gbar__badge {
    display: grid;
    flex: none;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--rc-accent) 16%, transparent);
    color: var(--rc-accent-ink, var(--rc-accent));
  }

  .rc-gbar__text {
    flex: 1;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .rc-gbar__actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 6px;
  }

  .rc-gbar__filter,
  .rc-gbar__link {
    padding: 5px 12px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  .rc-gbar__filter {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .rc-gbar__filter:hover,
  .rc-gbar__filter.is-active {
    background: var(--rc-accent-ink, var(--rc-accent));
    color: #fff;
  }

  .rc-gbar__link {
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
    color: inherit;
  }

  .rc-gbar__link:hover {
    border-color: var(--rc-accent);
  }

  .rc-gbar__clear {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: rgb(var(--color-foreground-rgb) / 0.6);
    cursor: pointer;
  }

  .rc-gbar__clear[hidden] {
    display: none;
  }

  .rc-gbar__clear:hover {
    background: rgb(var(--color-foreground-rgb) / 0.08);
    color: inherit;
  }

  @media screen and (max-width: 749px) {
    .rc-gbar__badge {
      display: none;
    }

    .rc-gbar__filter {
      max-width: 46vw;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rc-gbar__filter,
    .rc-gbar__link {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ricreo · Barra garage",
  "tag": "section",
  "class": "rc-gbar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Mostra l'auto salvata dal cliente con la ricerca dell'hero. Nelle collezioni aggiunge il filtro rapido per tag (es. volkswagen-golf-7)."
    },
    {
      "type": "checkbox",
      "id": "show_empty",
      "label": "Mostra anche senza auto salvata",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Testo senza auto",
      "default": "Scegli la tua auto e vedi solo i ricambi compatibili"
    },
    {
      "type": "url",
      "id": "finder_url",
      "label": "Pagina con la ricerca veicolo",
      "info": "Di solito la homepage (dove c'è l'hero). Il link porta direttamente al modulo di ricerca."
    }
  ],
  "presets": [
    {
      "name": "Ricreo · Barra garage",
      "category": "Ricreo"
    }
  ]
}
{% endschema %}
