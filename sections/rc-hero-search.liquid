{%- comment -%}
  Ricreo · Hero con ricerca.
  Una sola azione chiara per tutto il catalogo: cerca per nome, modello o codice ricambio.
  Le ricerche popolari diventano chip; il link opzionale porta a una categoria.
  A destra (solo desktop) una vetrina: il primo prodotto della collezione scelta in grande su uno sfondo
  caldo, con nome e prezzo, e due card prodotto che ci galleggiano sopra. Con una foto ambientata caricata,
  la foto prende il posto del prodotto in vetrina e le card mostrano i primi due prodotti.
{%- endcomment -%}

{%- liquid
  assign uid = section.id | handleize
  assign popular = section.settings.popular_searches | split: ','
  assign rotating = section.settings.rotating_terms | split: ','
  assign photo_collection = section.settings.photo_collection | default: collections.all
  assign hero_image = section.settings.hero_image
  assign p1 = nil
  assign p2 = nil
  assign p3 = nil

  if section.settings.show_photos
    for product in photo_collection.products limit: 12
      if product.featured_image == blank
        continue
      endif
      if p1 == blank
        assign p1 = product
      elsif p2 == blank
        assign p2 = product
      else
        assign p3 = product
        break
      endif
    endfor
  endif

  assign show_art = false
  if hero_image != blank and p2 != blank
    assign show_art = true
  elsif p3 != blank
    assign show_art = true
  endif

  if p1 != blank
    assign p1_name = p1.title | split: ' per ' | first
  endif
-%}

<div class="section section--full-width rc-hs-section">
  <div
    class="rc-hs rc-hs--{{ section.settings.style }}"
    style="--rc-pad-top: {{ section.settings.padding_top }}px; --rc-pad-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="rc-hs__inner{% if show_art %} rc-hs__inner--art{% endif %}">
      <div class="rc-hs__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="rc-hs__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="rc-hs__title">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="rc-hs__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <form class="rc-hs__search" action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
          <label class="visually-hidden" for="{{ uid }}-q">{{ section.settings.placeholder }}</label>
          {% render 'rc-icon', name: 'search', size: 20, class: 'rc-hs__search-icon' %}
          <input
            class="rc-hs__input"
            id="{{ uid }}-q"
            type="search"
            name="q"
            {% if rotating.size > 0 %}
              placeholder=" "
              aria-label="{{ section.settings.placeholder | escape }}"
            {% else %}
              placeholder="{{ section.settings.placeholder | escape }}"
            {% endif %}
            autocomplete="off"
            enterkeyhint="search"
          >
          {%- if rotating.size > 0 -%}
            {%- comment -%} Short examples that take turns, so the hint fits even a narrow phone field. {%- endcomment -%}
            <rc-rotator class="rc-hs__rotator" aria-hidden="true">
              {%- if section.settings.rotating_prefix != blank -%}
                <span class="rc-hs__rotator-prefix">{{ section.settings.rotating_prefix }}</span>
              {%- endif -%}
              <span class="rc-hs__rotator-words">
                {%- for term in rotating -%}
                  {%- assign term = term | strip -%}
                  {%- if term != blank -%}
                    <span class="rc-hs__rotator-word{% if forloop.first %} is-active{% endif %}">{{ term }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </span>
            </rc-rotator>
          {%- endif -%}
          <button class="rc-hs__submit" type="submit">
            <span>{{ section.settings.button_label }}</span>
            {% render 'rc-icon', name: 'arrow-right', size: 18 %}
          </button>
        </form>

        {%- if section.settings.popular_searches != blank -%}
          <div class="rc-hs__chips">
            {%- if section.settings.popular_label != blank -%}
              <span class="rc-hs__chips-label">{{ section.settings.popular_label }}</span>
            {%- endif -%}
            {%- for term in popular -%}
              {%- assign term = term | strip -%}
              {%- if term != blank -%}
                <a class="rc-hs__chip" href="{{ routes.search_url }}?q={{ term | url_encode }}&type=product">{{ term }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.auto_link_label != blank -%}
          <a class="rc-hs__auto" href="{{ section.settings.auto_link_url | default: routes.collections_url }}">
            <span class="rc-hs__auto-icon">{% render 'rc-icon', name: 'car', size: 18 %}</span>
            <span>{{ section.settings.auto_link_label }}</span>
            {% render 'rc-icon', name: 'arrow-right', size: 16 %}
          </a>
        {%- endif -%}
      </div>

      {%- if show_art -%}
        <div class="rc-hs__art">
          {%- if hero_image != blank -%}
            <div class="rc-hs__stage rc-hs__stage--photo">
              {{
                hero_image
                | image_url: width: 1400
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  class: 'rc-hs__stage-photo',
                  sizes: '(min-width: 990px) 560px, 1px',
                  alt: hero_image.alt | default: ''
              }}
            </div>
            {% render 'rc-product-chip', product: p1, class: 'rc-hs__float rc-hs__float--a', loading: 'eager' %}
            {% render 'rc-product-chip', product: p2, class: 'rc-hs__float rc-hs__float--b', loading: 'eager' %}
          {%- else -%}
            <a class="rc-hs__stage" href="{{ p1.url }}">
              {%- if section.settings.stage_label != blank -%}
                <span class="rc-hs__stage-tag">
                  {% render 'rc-icon', name: 'star', size: 14 %}
                  {{ section.settings.stage_label }}
                </span>
              {%- endif -%}
              {{
                p1.featured_image
                | image_url: width: 1000
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  class: 'rc-hs__stage-img',
                  sizes: '(min-width: 990px) 480px, 1px',
                  alt: ''
              }}
              <span class="rc-hs__stage-caption">
                <span class="rc-hs__stage-name">{{ p1_name }}</span>
                <span class="rc-hs__stage-price">
                  {{ p1.price | money }}
                  {%- if p1.compare_at_price > p1.price -%}
                    <s>{{ p1.compare_at_price | money }}</s>
                  {%- endif -%}
                  {% render 'rc-icon', name: 'arrow-right', size: 16 %}
                </span>
              </span>
            </a>
            {% render 'rc-product-chip', product: p2, class: 'rc-hs__float rc-hs__float--a', loading: 'eager' %}
            {% render 'rc-product-chip', product: p3, class: 'rc-hs__float rc-hs__float--b', loading: 'eager' %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if rotating.size > 0 -%}
  <script type="module">
    if (!customElements.get('rc-rotator')) {
      customElements.define(
        'rc-rotator',
        class extends HTMLElement {
          connectedCallback() {
            const words = [...this.querySelectorAll('.rc-hs__rotator-word')];
            if (!words.length) return;
            // The first word is already active in the markup, so it shows without a transition.
            let index = 0;
            if (words.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            this.timer = setInterval(() => {
              words[index].classList.replace('is-active', 'is-leaving');
              const leaving = words[index];
              setTimeout(() => leaving.classList.remove('is-leaving'), 400);
              index = (index + 1) % words.length;
              words[index].classList.add('is-active');
            }, 2600);
          }

          disconnectedCallback() {
            clearInterval(this.timer);
          }
        }
      );
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .rc-hs {
    --rc-hs-bg: color-mix(in srgb, var(--rc-accent) 5%, var(--color-background));
    --rc-hs-text: var(--color-foreground);
    --rc-hs-muted: rgb(var(--color-foreground-rgb) / 0.68);
    --rc-hs-field: var(--color-background);
    --rc-hs-border: rgb(var(--color-foreground-rgb) / 0.14);
    position: relative;
    overflow: hidden;
    padding-block: var(--rc-pad-top) var(--rc-pad-bottom);
    background:
      radial-gradient(60% 80% at 100% 0%, color-mix(in srgb, var(--rc-accent) 14%, transparent), transparent 70%),
      var(--rc-hs-bg);
    color: var(--rc-hs-text);
  }

  .rc-hs--dark {
    --rc-hs-bg: #0f1218;
    --rc-hs-text: #f5f7fa;
    --rc-hs-muted: rgb(245 247 250 / 0.7);
    --rc-hs-field: rgb(255 255 255 / 0.08);
    --rc-hs-border: rgb(255 255 255 / 0.16);
  }

  .rc-hs__inner {
    display: grid;
    gap: 40px;
    align-items: center;
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  @media screen and (min-width: 990px) {
    .rc-hs__inner--art {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 64px;
    }
  }

  .rc-hs__copy {
    display: grid;
    gap: 18px;
    min-width: 0;
    max-width: 680px;
  }

  .rc-hs__eyebrow {
    justify-self: start;
    margin: 0;
    padding: 6px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--rc-accent) 12%, transparent);
    color: var(--rc-accent-ink, var(--rc-accent));
    font-size: 0.8rem;
    font-weight: 600;
  }

  .rc-hs--dark .rc-hs__eyebrow {
    color: var(--rc-accent);
  }

  .rc-hs__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: clamp(2rem, 6vw, 3.8rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: inherit;
  }

  /* Italic words in the heading get a soft marker highlight instead of italics. */
  .rc-hs__title em {
    font-style: normal;
    background: linear-gradient(transparent 62%, color-mix(in srgb, var(--rc-accent) 30%, transparent) 62%);
    padding-inline: 2px;
  }

  .rc-hs__sub {
    margin: 0;
    max-width: 56ch;
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    line-height: 1.55;
    color: var(--rc-hs-muted);
  }

  .rc-hs__search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-block-start: 6px;
    padding: 6px;
    border: 1.5px solid var(--rc-hs-border);
    border-radius: 18px;
    background: var(--rc-hs-field);
    box-shadow: 0 18px 40px -28px rgb(0 0 0 / 0.45);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .rc-hs__search:focus-within {
    border-color: var(--rc-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--rc-accent) 22%, transparent);
  }

  .rc-hs__search-icon {
    flex: none;
    margin-inline-start: 10px;
    opacity: 0.55;
  }

  .rc-hs__input {
    flex: 1;
    min-width: 0;
    height: 46px;
    padding: 0 4px;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1rem;
    outline: none;
    box-shadow: none;
  }

  .rc-hs__input::placeholder {
    color: var(--rc-hs-muted);
    opacity: 1;
  }

  .rc-hs__input::-webkit-search-cancel-button {
    display: none;
  }

  /* Rotating hint over the empty field; gone as soon as the customer focuses or types. */
  .rc-hs__rotator {
    position: absolute;
    inset-inline: 44px 120px;
    inset-block: 6px;
    display: flex;
    align-items: center;
    gap: 0.3em;
    overflow: hidden;
    color: var(--rc-hs-muted);
    font-size: 1rem;
    white-space: nowrap;
    pointer-events: none;
  }

  .rc-hs__input:focus ~ .rc-hs__rotator,
  .rc-hs__input:not(:placeholder-shown) ~ .rc-hs__rotator {
    visibility: hidden;
  }

  .rc-hs__rotator-words {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 1.5em;
    overflow: hidden;
  }

  .rc-hs__rotator-word {
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: var(--rc-hs-text);
    font-weight: 600;
    text-overflow: ellipsis;
    opacity: 0;
    transform: translateY(70%);
    transition: opacity 0.35s, transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .rc-hs__rotator-word.is-active {
    opacity: 1;
    transform: none;
  }

  .rc-hs__rotator-word.is-leaving {
    opacity: 0;
    transform: translateY(-70%);
  }

  .rc-hs__submit {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
    height: 46px;
    padding-inline: 18px;
    border: 0;
    border-radius: 13px;
    background: var(--rc-accent-ink, var(--rc-accent));
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s, background-color 0.2s;
  }

  .rc-hs__submit:hover {
    background: var(--rc-accent);
  }

  .rc-hs__submit:active {
    transform: scale(0.97);
  }

  .rc-hs__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .rc-hs__chips-label {
    margin-inline-end: 2px;
    font-size: 0.82rem;
    color: var(--rc-hs-muted);
  }

  .rc-hs__chip {
    padding: 7px 13px;
    border: 1px solid var(--rc-hs-border);
    border-radius: 999px;
    background: var(--rc-hs-field);
    color: inherit;
    font-size: 0.86rem;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .rc-hs__chip:hover {
    border-color: var(--rc-accent);
    background: color-mix(in srgb, var(--rc-accent) 10%, var(--rc-hs-field));
  }

  .rc-hs__auto {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .rc-hs__auto-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--rc-accent) 14%, transparent);
    color: var(--rc-accent-ink, var(--rc-accent));
  }

  .rc-hs__auto:hover > span:not(.rc-hs__auto-icon) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Showcase (desktop only): one product on a warm stage, two product cards floating over its edges. */
  .rc-hs__art {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .rc-hs__art {
      position: relative;
      display: block;
      width: 100%;
      max-width: 560px;
      justify-self: end;
      padding-inline-start: 56px;
      padding-block: 8px 28px;
    }
  }

  .rc-hs__stage {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1.02;
    overflow: hidden;
    border-radius: 32px;
    background:
      radial-gradient(55% 45% at 50% 46%, #fff 0%, transparent 100%),
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--rc-accent) 22%, transparent) 1px, transparent 0) 0 0 / 18px 18px,
      linear-gradient(160deg, color-mix(in srgb, var(--rc-accent) 10%, #fff), color-mix(in srgb, var(--rc-accent) 24%, #fff));
    color: var(--color-foreground);
    text-decoration: none;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.04);
  }

  /* Soft floor shadow under the piece. */
  .rc-hs__stage:not(.rc-hs__stage--photo)::after {
    content: '';
    position: absolute;
    inset: auto 22% 25% 22%;
    height: 7%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.16), transparent);
    filter: blur(4px);
    pointer-events: none;
  }

  .rc-hs__stage-img {
    position: absolute;
    inset: 12% 6% 27% 22%;
    z-index: 1;
    width: 72%;
    height: 61%;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .rc-hs__stage:hover .rc-hs__stage-img {
    transform: translateY(-6px) rotate(-1.5deg) scale(1.03);
  }

  .rc-hs__stage-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rc-hs__stage-tag {
    position: absolute;
    inset: 22px auto auto 22px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--color-background);
    color: var(--rc-accent-ink, var(--rc-accent));
    font-size: 0.78rem;
    font-weight: 700;
    box-shadow: 0 6px 16px -10px rgb(0 0 0 / 0.35);
  }

  .rc-hs__stage-caption {
    position: absolute;
    inset: auto 28px 26px 28px;
    z-index: 2;
    display: grid;
    gap: 4px;
  }

  .rc-hs__stage-name {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .rc-hs__stage-price {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--rc-accent-ink, var(--rc-accent));
  }

  .rc-hs__stage-price s {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgb(var(--color-foreground-rgb) / 0.5);
  }

  .rc-hs__stage-price .rc-icon {
    transition: transform 0.3s;
  }

  .rc-hs__stage:hover .rc-hs__stage-price .rc-icon {
    transform: translateX(4px);
  }

  .rc-hs__float {
    position: absolute;
    z-index: 3;
    width: min(270px, 56%);
  }

  .rc-hs__float--a {
    inset: 40% auto auto 0;
    width: min(240px, 50%);
  }

  .rc-hs__float--b {
    inset: auto -20px 0 auto;
  }

  /* With a lifestyle photo there is no caption: the second card moves to the top corner. */
  .rc-hs__stage--photo ~ .rc-hs__float--a {
    inset: auto auto 18% 0;
  }

  .rc-hs__stage--photo ~ .rc-hs__float--b {
    inset: 10% -20px auto auto;
  }

  /* Small laptops: the stage is narrow, so a single card keeps the names readable. */
  @media screen and (max-width: 1199px) {
    .rc-hs__art {
      padding-inline-start: 24px;
    }

    /* Scoped to the art: the chip's own display: grid lands later in Shopify's stylesheet bundle. */
    .rc-hs__art .rc-hs__float--a {
      display: none;
    }

    .rc-hs__float--b {
      width: 250px;
    }
  }

  /* Phones: compact, search first, chips in one swipeable row. */
  @media screen and (max-width: 749px) {
    .rc-hs {
      padding-block: min(var(--rc-pad-top), 32px) min(var(--rc-pad-bottom), 28px);
    }

    .rc-hs__copy {
      gap: 14px;
    }

    .rc-hs__sub {
      font-size: 0.95rem;
    }

    .rc-hs__submit {
      width: 46px;
      padding: 0;
      justify-content: center;
    }

    .rc-hs__rotator {
      inset-inline-end: 62px;
    }

    .rc-hs__submit span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .rc-hs__chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--page-margin, 16px) * -1);
      padding-inline: var(--page-margin, 16px);
      scrollbar-width: none;
    }

    .rc-hs__chips::-webkit-scrollbar {
      display: none;
    }

    .rc-hs__chips-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rc-hs__stage-img,
    .rc-hs__stage-price .rc-icon,
    .rc-hs__submit,
    .rc-hs__search,
    .rc-hs__rotator-word {
      transition: none;
    }

    .rc-hs__stage:hover .rc-hs__stage-img,
    .rc-hs__stage:hover .rc-hs__stage-price .rc-icon {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ricreo · Hero ricerca",
  "tag": "section",
  "class": "rc-hs-shopify-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Stile",
      "options": [
        { "value": "light", "label": "Chiaro" },
        { "value": "dark", "label": "Scuro" }
      ],
      "default": "light"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etichetta sopra il titolo",
      "default": "Ricambi e accessori compatibili"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titolo",
      "info": "Il testo in corsivo viene evidenziato.",
      "default": "Ricambi e accessori <em>che non trovi altrove.</em>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sottotitolo",
      "default": "Li progettiamo e produciamo noi. Su ogni scheda trovi i modelli con cui funzionano."
    },
    {
      "type": "header",
      "content": "Ricerca"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Testo nel campo di ricerca",
      "default": "Nome, modello o codice ricambio"
    },
    {
      "type": "text",
      "id": "rotating_prefix",
      "label": "Esempi a rotazione: testo fisso",
      "default": "Cerca"
    },
    {
      "type": "text",
      "id": "rotating_terms",
      "label": "Esempi a rotazione",
      "info": "Brevi, separati da virgola (es. Citroën Ami, specchietto). Si alternano nel campo vuoto al posto del testo qui sopra. Vuoto = testo fisso."
