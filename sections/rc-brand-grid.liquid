{%- comment -%}
  Ricreo · Marchi e modelli.
  Il cliente parte da quello che possiede (la sua auto, la sua Sodastream, la sua macchina del caffè…),
  non da una categoria. Ogni blocco è un marchio o un modello con la foto di quell'oggetto, caricata
  nell'editor; finché non c'è, un'icona. Mai la foto di un accessorio: la tessera rappresenta ciò che il
  cliente ha, non ciò che compra.
  Un blocco compare solo se nel catalogo c'è almeno un prodotto con una delle sue parole chiave nel titolo,
  così la sezione cresce da sola man mano che si caricano prodotti, senza tessere che portano al vuoto.
  Con una o due tessere la sezione usa schede larghe, per non lasciare un riquadro isolato.
  Finché nessuna tessera ha la foto, le tessere sono compatte (icona accanto al nome) invece di grandi
  riquadri vuoti; le colonne si scelgono in base al numero di tessere, così l'ultima fila non resta con
  una tessera sola.
{%- endcomment -%}

{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign shown = 0
  assign with_photo = 0
  assign with_sub = 0
-%}

{%- capture tiles -%}
  {%- paginate source.products by 250 -%}
    {%- for block in section.blocks -%}
      {%- liquid
        if block.settings.title == blank
          continue
        endif

        assign match = block.settings.match | default: block.settings.title
        assign terms = match | downcase | split: ','
        assign count = 0

        for product in source.products
          assign product_title = product.title | downcase
          for term in terms
            assign term = term | strip
            if term != blank and product_title contains term
              assign count = count | plus: 1
              break
            endif
          endfor
        endfor

        if count == 0
          continue
        endif

        assign shown = shown | plus: 1
        if block.settings.image != blank
          assign with_photo = with_photo | plus: 1
        endif
        if block.settings.subtitle != blank
          assign with_sub = with_sub | plus: 1
        endif
        assign url = block.settings.link
        if url == blank
          assign query = block.settings.title | url_encode
          assign url = routes.search_url | append: '?q=' | append: query | append: '&type=product&options[prefix]=last'
        endif
      -%}
      <li
        class="rc-brands__item{% if block.settings.subtitle != blank %} rc-brands__item--sub{% endif %}"
        {{ block.shopify_attributes }}
      >
        <a class="rc-brand" href="{{ url }}">
          <span class="rc-brand__media{% if block.settings.image == blank %} rc-brand__media--icon{% endif %}">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 640
                | image_tag:
                  loading: 'lazy',
                  class: 'rc-brand__img',
                  sizes: '(min-width: 990px) 320px, 60vw',
                  alt: ''
              }}
            {%- else -%}
              <span class="rc-brand__badge">{% render 'rc-icon', name: block.settings.icon, size: 34 %}</span>
              {%- if request.design_mode -%}
                <span class="rc-brand__hint">Carica la foto · 1200 × 900 px</span>
              {%- endif -%}
            {%- endif -%}
          </span>
          <span class="rc-brand__body">
            <span class="rc-brand__name">{{ block.settings.title }}</span>
            {%- if block.settings.subtitle != blank -%}
              <span class="rc-brand__sub">{{ block.settings.subtitle }}</span>
            {%- endif -%}
            <span class="rc-brand__count">
              {%- if count == 1 -%}1 prodotto{%- else -%}{{ count }} prodotti{%- endif -%}
              {% render 'rc-icon', name: 'arrow-right', size: 16 %}
            </span>
          </span>
        </a>
      </li>
    {%- endfor -%}
  {%- endpaginate -%}
{%- endcapture -%}

{%- if shown >= section.settings.min_visible -%}
  <div class="section section--page-width rc-brands-section">
    <div
      class="rc-brands"
      style="--rc-pad-top: {{ section.settings.padding_top }}px; --rc-pad-bottom: {{ section.settings.padding_bottom }}px;"
    >
      {%- if section.settings.heading != blank -%}
        <header class="rc-brands__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="rc-brands__kicker">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="rc-brands__title">{{ section.settings.heading }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="rc-brands__sub">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- liquid
        case shown
          when 3, 6, 9
            assign cols = 3
          when 5, 10
            assign cols = 5
          else
            assign cols = 4
        endcase

        # Phones: tiles with a subtitle take a whole row, the others go two by two.
        assign paired = shown | minus: with_sub | modulo: 2
      -%}
      <ul
        class="rc-brands__list{% if shown < 3 %} rc-brands__list--wide{% elsif with_photo == 0 %} rc-brands__list--compact{% if paired == 1 %} rc-brands__list--odd{% endif %}{% endif %}"
        style="--rc-cols: {{ cols }};"
        role="list"
      >
        {{ tiles }}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .rc-brands {
    padding-block: var(--rc-pad-top) var(--rc-pad-bottom);
  }

  .rc-brands__header {
    margin-block-end: 24px;
  }

  .rc-brands__kicker {
    margin: 0 0 8px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rc-accent, currentColor);
  }

  .rc-brands__title {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .rc-brands__sub {
    margin: 8px 0 0;
    color: rgb(var(--color-foreground-rgb) / 0.68);
  }

  .rc-brands__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rc-brand {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    border-radius: 16px;
    background: var(--color-background);
    color: var(--color-foreground);
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.3s, box-shadow 0.3s;
  }

  .rc-brand:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--rc-accent) 45%, transparent);
    box-shadow: 0 18px 32px -22px color-mix(in srgb, var(--rc-accent) 70%, transparent);
  }

  .rc-brand__media {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  /* Photos of the vehicle or device fill the frame. */
  .rc-brand__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* No photo yet: the icon sits in a white disc on a soft dotted tint, like a placeholder on purpose. */
  .rc-brand__media--icon {
    position: relative;
    background:
      radial-gradient(circle at 50% 50%, rgb(255 255 255 / 0.85), transparent 58%),
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--rc-accent) 20%, transparent) 1px, transparent 0) 0 0 / 16px 16px,
      linear-gradient(160deg, color-mix(in srgb, var(--rc-accent) 8%, #fff), color-mix(in srgb, var(--rc-accent) 18%, #fff));
    color: var(--rc-accent-ink, var(--rc-accent));
  }

  .rc-brand__badge {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--color-background);
    box-shadow: 0 12px 26px -14px color-mix(in srgb, var(--rc-accent) 80%, transparent);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1.4);
  }

  .rc-brand:hover .rc-brand__badge {
    transform: scale(1.08) rotate(-4deg);
  }

  /* Theme editor only: where the photo goes and what size. */
  .rc-brand__hint {
    position: absolute;
    inset: auto 8px 8px;
    padding: 4px 8px;
    border: 1px dashed currentColor;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.8);
    font-size: 0.7rem;
    font-weight: 600;
    text-align: center;
  }

  /* Text starts right under the picture; the product count sits at the bottom, level across the row. */
  .rc-brand__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px 14px;
  }

  .rc-brand__name {
    font-weight: 700;
    line-height: 1.25;
  }

  .rc-brand__sub {
    font-size: 0.86rem;
    line-height: 1.4;
    opacity: 0.75;
  }

  .rc-brand__count {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-block-start: auto;
    padding-block-start: 6px;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--rc-accent-ink, var(--rc-accent));
  }

  .rc-brand__count .rc-icon {
    transition: transform 0.3s;
  }

  .rc-brand:hover .rc-brand__count .rc-icon {
    transform: translateX(3px);
  }

  /* One or two tiles: wide cards, picture beside the text, so nothing sits alone in a big grid. */
  .rc-brands__list--wide {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
  }

  .rc-brands__list--wide .rc-brand {
    grid-template-rows: none;
    grid-template-columns: 40% 1fr;
    align-items: center;
  }

  .rc-brands__list--wide .rc-brand__media {
    height: 100%;
    min-height: 140px;
    aspect-ratio: auto;
  }

  .rc-brands__list--wide .rc-brand__body {
    padding: 18px 20px;
  }

  .rc-brands__list--wide .rc-brand__name {
    font-size: 1.15rem;
  }

  /* Three or more tiles: as many columns as keep the rows full (6 → 3 + 3, 8 → 4 + 4). */
  @media screen and (min-width: 990px) {
    .rc-brands__list:not(.rc-brands__list--wide) {
      grid-template-columns: repeat(var(--rc-cols, 4), minmax(0, 1fr));
    }
  }

  /* No photos yet: compact tiles, the icon beside the name, instead of big empty frames. */
  .rc-brands__list--compact .rc-brand {
    grid-template-rows: none;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--rc-accent) 10%, transparent), transparent 60%),
      var(--color-background);
  }

  .rc-brands__list--compact .rc-brand__media {
    aspect-ratio: auto;
    overflow: visible;
    background: none;
  }

  .rc-brands__list--compact .rc-brand__badge {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--rc-accent) 12%, var(--color-background));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--rc-accent) 18%, transparent);
  }

  .rc-brands__list--compact .rc-brand__badge .rc-icon {
    width: 28px;
    height: 28px;
  }

  .rc-brands__list--compact .rc-brand__hint {
    display: none;
  }

  .rc-brands__list--compact .rc-brand__body {
    padding: 0;
  }

  .rc-brands__list--compact .rc-brand__name {
    font-size: 1.05rem;
  }

  .rc-brands__list--compact .rc-brand__count {
    padding-block-start: 4px;
  }

  /* Phones: one swipeable row so the section never pushes the rest far down. */
  @media screen and (max-width: 749px) {
    .rc-brands {
      padding-block: min(var(--rc-pad-top), 32px) min(var(--rc-pad-bottom), 24px);
    }

    .rc-brands__header {
      margin-block-end: 16px;
    }

    .rc-brands__list {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      margin-inline: calc(var(--page-margin, 16px) * -1);
      padding-inline: var(--page-margin, 16px);
      padding-block-end: 4px;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-margin, 16px);
      scrollbar-width: none;
    }

    .rc-brands__list::-webkit-scrollbar {
      display: none;
    }

    .rc-brands__item {
      flex: 0 0 42%;
      scroll-snap-align: start;
    }

    .rc-brands__list--wide .rc-brands__item {
      flex-basis: 100%;
    }

    .rc-brands__list--wide .rc-brand__media {
      min-height: 112px;
    }

    .rc-brands__list--wide .rc-brand__body {
      padding: 12px 14px;
    }

    .rc-brands__list--wide .rc-brand__name {
      font-size: 1rem;
    }

    .rc-brand__body {
      padding: 10px 12px 12px;
    }

    .rc-brand__name {
      font-size: 0.92rem;
    }

    /* Narrow tiles: a long subtitle would make the whole row tall. */
    .rc-brands__list:not(.rc-brands__list--wide) .rc-brand__sub {
      display: none;
    }

    .rc-brand__badge {
      width: 56px;
      height: 56px;
    }

    .rc-brand__badge .rc-icon {
      width: 28px;
      height: 28px;
    }

    /* Compact tiles are short enough for a two-column grid: everything in view, no swiping. */
    .rc-brands__list--compact {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }

    .rc-brands__list--compact .rc-brands__item--sub,
    .rc-brands__list--odd .rc-brands__item:last-child {
      grid-column: 1 / -1;
    }

    .rc-brands__list--compact .rc-brand {
      gap: 10px;
      padding: 12px;
    }

    .rc-brands__list--compact .rc-brand__badge {
      width: 40px;
      height: 40px;
      border-radius: 12px;
    }

    .rc-brands__list--compact .rc-brand__badge .rc-icon {
      width: 22px;
      height: 22px;
    }

    .rc-brands__list--compact .rc-brand__name {
      font-size: 0.92rem;
    }

    .rc-brands__list--compact .rc-brands__item--sub .rc-brand__sub {
      display: block;
    }
  }

  /* Tablets: two columns of compact tiles; a lone last tile spans the row. */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .rc-brands__list--compact {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rc-brands__list--compact .rc-brands__item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rc-brand,
    .rc-brand .rc-icon,
    .rc-brand__badge {
      transition: none;
    }

    .rc-brand:hover,
    .rc-brand:hover .rc-icon,
    .rc-brand:hover .rc-brand__badge {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ricreo · Marchi e modelli",
  "tag": "section",
  "class": "rc-brands-shopify-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etichetta",
      "default": "Per marca o modello"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Per cosa ti serve?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sottotitolo",
      "default": "Scegli quello che hai: vedi solo i pezzi fatti per quel modello."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Cerca i prodotti in",
      "info": "Vuoto = tutto il catalogo (primi 250 prodotti)."
    },
    {
      "type": "range",
      "id": "min_visible",
      "label": "Mostra la sezione da",
      "info": "Numero minimo di tessere con prodotti perché la sezione compaia.",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Spaziatura superiore",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Spaziatura inferiore",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca o modello",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nome",
          "info": "Es. Citroën Ami, Sodastream, Lavazza A Modo Mio."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Sottotitolo",
          "info": "Facoltativo, es. \"Stessi ricambi per tutti e tre i modelli\"."
        },
        {
          "type": "text",
          "id": "match",
          "label": "Parole nel titolo prodotto",
          "info": "Separate da virgola, es. \"citroën ami, citroen ami\". Vuoto = il nome. La tessera compare solo se almeno un prodotto le contiene."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Vuoto = ricerca del nome nel negozio."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto del veicolo o dell'oggetto",
          "info": "La cosa che il cliente possiede (l'auto, la macchina del caffè…), non l'accessorio. Vuoto = icona."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icona (se non c'è la foto)",
          "options": [
            { "value": "car", "label": "Auto" },
            { "value": "bolt", "label": "Elettrico / microcar" },
            { "value": "scooter", "label": "Moto" },
            { "value": "van", "label": "Camper" },
            { "value": "home", "label": "Casa" },
            { "value": "drop", "label": "Acqua / bevande" },
            { "value": "monitor", "label": "Tech" },
            { "value": "bug", "label": "Insetti" },
            { "value": "leaf", "label": "Giardino" },
            { "value": "ruler", "label": "Fai da te" },
            { "value": "star", "label": "Sport e tempo libero" },
            { "value": "wrench", "label": "Altro" }
          ],
          "default": "wrench"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ricreo · Marchi e modelli",
      "category": "Ricreo",
      "blocks": [
        { "type": "brand", "settings": { "title": "Citroën Ami", "match": "citroën ami, citroen ami", "icon": "bolt" } },
        { "type": "brand", "settings": { "title": "Sodastream", "icon": "drop" } },
        { "type": "brand", "settings": { "title": "Lavazza", "icon": "home" } },
        { "type": "brand", "settings": { "title": "IKEA", "icon": "home" } }
      ]
    }
  ]
}
{% endschema %}
