{%- comment -%}
  Ricreo · Compatibilità veicolo (pagina prodotto).
  Se il cliente ha salvato un veicolo e il prodotto risulta compatibile (tag marca-modello,
  "universale" o modello citato nel titolo) mostra "Compatibile con la tua …"; altrimenti non mostra nulla.
  Il contenuto è generato da rc-garage.js (caricato da snippets/rc-global.liquid).
{%- endcomment -%}

{%- assign product = closest.product -%}

{%- if product != blank -%}
  <rc-compat
    data-context="product"
    data-tags="{{ product.tags | join: '|' | escape }}"
    data-title="{{ product.title | escape }}"
    hidden
    {{ block.shopify_attributes }}
  ></rc-compat>
{%- endif -%}

{% schema %}
{
  "name": "Ricreo · Compatibilità",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Compare solo se il cliente ha scelto un veicolo (nelle categorie auto) e il prodotto è compatibile: tag marca-modello (es. volkswagen-golf-7), solo marca, \"universale\", oppure modello citato nel titolo."
    }
  ],
  "presets": [
    {
      "name": "Ricreo · Compatibilità",
      "category": "Ricreo"
    }
  ]
}
{% endschema %}
