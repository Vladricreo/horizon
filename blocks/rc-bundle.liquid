{%- doc -%}
  Ricreo · "Spesso acquistati insieme" (pagina prodotto).
  Suggerisce articoli abbinabili al prodotto corrente E a quelli già nel carrello,
  con selezione a spunta, totale dinamico e aggiunta in un solo click.

  Fonti, in ordine: metafield `custom.abbinabili` del prodotto → complementari Search & Discovery
  → abbinabili degli articoli nel carrello → prodotti scelti nel blocco → collezione di riserva.
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  if product == blank and request.visual_preview_mode
    assign product = collections.all.products.first
  endif
  assign main_variant = product.selected_or_first_available_variant

  assign limit = block.settings.limit
  assign exclude = ',' | append: product.id | append: ','
  for item in cart.items
    assign exclude = exclude | append: item.product_id | append: ','
  endfor
  assign picked = ','
  assign count = 0
-%}

{%- capture rows -%}
  {%- for source in (1..5) -%}
    {%- if count >= limit -%}{%- break -%}{%- endif -%}
    {%- liquid
      case source
        when 1
          assign recs = product.metafields.custom.abbinabili.value
          assign reason = 'match'
        when 2
          assign recs = product.metafields['shopify--discovery--product_recommendation'].complementary_products.value
          assign reason = 'match'
        when 3
          assign recs = blank
          assign reason = 'cart'
        when 4
          assign recs = block.settings.products
          assign reason = 'match'
        when 5
          assign recs = block.settings.collection.products
          assign reason = 'popular'
      endcase
    -%}

    {%- if source == 3 -%}
      {%- for item in cart.items reversed -%}
        {%- assign cart_recs = item.product.metafields.custom.abbinabili.value | default: item.product.metafields['shopify--discovery--product_recommendation'].complementary_products.value -%}
        {%- for rec in cart_recs -%}
          {%- if count >= limit -%}{%- break -%}{%- endif -%}
          {%- liquid
            assign key = ',' | append: rec.id | append: ','
            assign eligible = rec.available
            if exclude contains key or picked contains key
              assign eligible = false
            endif
          -%}
          {%- if eligible -%}
            {%- render 'rc-bundle-row', product: rec, reason: 'cart', reason_title: item.product.title, index: count -%}
            {%- assign picked = picked | append: rec.id | append: ',' -%}
            {%- assign count = count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- else -%}
      {%- for rec in recs limit: 24 -%}
        {%- if count >= limit -%}{%- break -%}{%- endif -%}
        {%- liquid
          assign key = ',' | append: rec.id | append: ','
          assign eligible = rec.available
          if exclude contains key or picked contains key
            assign eligible = false
          endif
        -%}
        {%- if eligible -%}
          {%- render 'rc-bundle-row', product: rec, reason: reason, index: count -%}
          {%- assign picked = picked | append: rec.id | append: ',' -%}
          {%- assign count = count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if count > 0 and product != blank -%}
  <script src="{{ 'rc-upsell.js' | asset_url }}" type="module" fetchpriority="low"></script>

  <rc-bundle
    class="rc-bundle"
    data-product-id="{{ product.id }}"
    data-money-format="{{ shop.money_format | strip_html | escape }}"
    data-currency="{{ cart.currency.iso_code }}"
    style="--rc-accent: {{ block.settings.accent }};"
    {{ block.shopify_attributes }}
  >
    <script type="application/json" data-rc-main-variants>
      {
        {%- for v in product.variants -%}
          "{{ v.id }}": {"price": {{ v.price }}, "compare": {{ v.compare_at_price | default: 0 }}, "available": {{ v.available }}}
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    </script>

    <div class="rc-bundle__head">
      <p class="rc-bundle__title">
        {% render 'rc-icon', name: 'gift', size: 18 %}
        {{ block.settings.heading }}
      </p>
      {%- if cart.item_count > 0 and block.settings.cart_note != blank -%}
        <p class="rc-bundle__sub">{{ block.settings.cart_note }}</p>
      {%- elsif block.settings.subheading != blank -%}
        <p class="rc-bundle__sub">{{ block.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <ul class="rc-bundle__list" role="list">
      <li class="rc-bundle__row rc-bundle__row--main">
        <label class="rc-bundle__check">
          <input
            type="checkbox"
            checked
            data-rc-bundle-main
            aria-label="Includi {{ product.title | escape }}"
          >
          <span class="rc-bundle__box" aria-hidden="true">{% render 'rc-icon', name: 'check', size: 14 %}</span>
        </label>
        <span class="rc-bundle__thumb">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', sizes: '56px' }}
          {%- endif -%}
        </span>
        <span class="rc-bundle__info">
          <span class="rc-bundle__badge rc-bundle__badge--main">Questo articolo</span>
          <span class="rc-bundle__name">{{ product.title }}</span>
        </span>
        <span class="rc-bundle__price" data-rc-main-price>{{ main_variant.price | money }}</span>
      </li>
      {{ rows }}
    </ul>

    <div class="rc-bundle__footer">
      <div class="rc-bundle__total">
        <span class="rc-bundle__total-label">Totale <span data-rc-count></span></span>
        <span class="rc-bundle__total-value">
          <s data-rc-compare hidden></s>
          <strong data-rc-total></strong>
        </span>
      </div>
      <button type="button" class="rc-bundle__cta" data-rc-bundle-add>
        {% render 'rc-icon', name: 'cart', size: 18 %}
        <span data-rc-cta-label>{{ block.settings.button_label }}</span>
      </button>
    </div>
    <p class="rc-bundle__error" data-rc-error role="alert" hidden></p>
  </rc-bundle>
{%- elsif request.design_mode -%}
  <div class="rc-bundle rc-bundle--empty" {{ block.shopify_attributes }}>
    <p class="rc-bundle__title">{% render 'rc-icon', name: 'gift', size: 18 %} {{ block.settings.heading }}</p>
    <p class="rc-bundle__sub">
      Nessun articolo abbinabile trovato. Compila il metafield "custom.abbinabili", usa i prodotti complementari di
      Search &amp; Discovery oppure scegli prodotti o una collezione di riserva nelle impostazioni del blocco.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .rc-bundle {
    --rc-accent: #ff5a1f;
    container-type: inline-size;
    display: grid;
    gap: 14px;
    width: 100%;
    padding: 18px;
    border-radius: 20px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    background:
      radial-gradient(120% 120% at 100% 0%, color-mix(in srgb, var(--rc-accent) 7%, transparent), transparent 55%),
      rgb(var(--color-foreground-rgb) / 0.02);
  }

  .rc-bundle--empty {
    border-style: dashed;
  }

  .rc-bundle__head {
    display: grid;
    gap: 2px;
  }

  .rc-bundle__title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-weight: 700;
    font-size: 1rem;
  }

  .rc-bundle__title .rc-icon {
    color: var(--rc-accent);
  }

  .rc-bundle__sub {
    margin: 0;
    font-size: 0.86rem;
    opacity: 0.7;
  }

  .rc-bundle__list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rc-bundle__row {
    display: grid;
    grid-template-columns: auto 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 8px 10px 8px 8px;
    border-radius: 14px;
    background: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.07);
    transition: opacity 0.25s, border-color 0.25s;
  }

  .rc-bundle__row:has([data-rc-bundle-check]:not(:checked)),
  .rc-bundle__row--main:has([data-rc-bundle-main]:not(:checked)) {
    opacity: 0.55;
  }

  .rc-bundle__row:has([data-rc-bundle-check]:checked),
  .rc-bundle__row--main:has([data-rc-bundle-main]:checked) {
    border-color: color-mix(in srgb, var(--rc-accent) 35%, transparent);
  }

  .rc-bundle__check {
    position: relative;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .rc-bundle__check input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .rc-bundle__box {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    border: 1.5px solid rgb(var(--color-foreground-rgb) / 0.3);
    color: transparent;
    transition: all 0.2s;
  }

  .rc-bundle__check input:checked + .rc-bundle__box {
    border-color: var(--rc-accent);
    background: var(--rc-accent);
    color: #fff;
  }

  .rc-bundle__check input:focus-visible + .rc-bundle__box {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--rc-accent) 35%, transparent);
  }

  .rc-bundle__thumb {
    display: block;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: 10px;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .rc-bundle__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .rc-bundle__info {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .rc-bundle__name {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.3;
    color: inherit;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  a.rc-bundle__name:hover {
    text-decoration: underline;
  }

  .rc-bundle__badge {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    background: color-mix(in srgb, var(--rc-accent) 13%, transparent);
    color: var(--rc-accent);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rc-bundle__badge--main {
    background: rgb(var(--color-foreground-rgb) / 0.08);
    color: inherit;
  }

  .rc-bundle__badge--cart {
    background: rgb(22 163 74 / 0.12);
    color: #15803d;
  }

  .rc-bundle__variant {
    max-width: 100%;
    height: 30px;
    padding: 0 6px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.78rem;
  }

  .rc-bundle__price {
    display: grid;
    justify-items: end;
    font-size: 0.9rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .rc-bundle__price s {
    font-size: 0.76rem;
    font-weight: 400;
    opacity: 0.5;
  }

  @container (max-width: 380px) {
    .rc-bundle__row {
      grid-template-columns: auto 48px minmax(0, 1fr);
      gap: 4px 10px;
    }

    .rc-bundle__thumb {
      width: 48px;
      height: 48px;
      grid-row: span 2;
    }

    .rc-bundle__check {
      grid-row: span 2;
    }

    .rc-bundle__price {
      grid-column: 3;
      justify-items: start;
      grid-auto-flow: column;
      justify-content: start;
      gap: 6px;
    }
  }

  .rc-bundle__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    padding-block-start: 4px;
  }

  .rc-bundle__total {
    display: grid;
    gap: 0;
  }

  .rc-bundle__total-label {
    font-size: 0.78rem;
    opacity: 0.65;
  }

  .rc-bundle__total-value {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-size: 1.25rem;
  }

  .rc-bundle__total-value s {
    font-size: 0.9rem;
    opacity: 0.5;
  }

  .rc-bundle__cta {
    flex: 1 1 200px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--style-border-radius-buttons-primary, 14px);
    background: var(--rc-accent);
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
    box-shadow: 0 10px 24px -12px var(--rc-accent);
  }

  .rc-bundle__cta:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .rc-bundle__cta:disabled,
  .rc-bundle__cta[aria-busy='true'] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .rc-bundle__cta.is-added {
    background: #16a34a;
    box-shadow: none;
  }

  .rc-bundle__error {
    margin: 0;
    font-size: 0.85rem;
    color: #dc2626;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ricreo · Comprati insieme",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Spesso acquistati insieme"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sottotitolo",
      "default": "Completa il lavoro con gli articoli abbinabili."
    },
    {
      "type": "text",
      "id": "cart_note",
      "label": "Sottotitolo se il carrello non è vuoto",
      "default": "Selezionati anche in base a ciò che hai già nel carrello."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo pulsante",
      "default": "Aggiungi selezionati"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Articoli suggeriti",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Riserva"
    },
    {
      "type": "paragraph",
      "content": "Usati solo se il prodotto e il carrello non hanno articoli abbinabili (metafield custom.abbinabili o complementari di Search & Discovery)."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Prodotti",
      "limit": 8
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collezione"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Colore d'accento",
      "default": "#FF5A1F"
    }
  ],
  "presets": [
    {
      "name": "Ricreo · Comprati insieme",
      "category": "Ricreo"
    }
  ]
}
{% endschema %}
